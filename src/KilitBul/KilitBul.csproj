<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\KilitBul.ico</ApplicationIcon>
    <AssemblyName>KilitBul</AssemblyName>
    <RootNamespace>KilitBul</RootNamespace>
    <Version>1.2.0</Version>
    <Product>KilitBul</Product>
    <Description>Dosyayı/klasörü kilitleyen işlemleri bulur ve sonlandırır.</Description>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\KilitBul.ico" />
    <Resource Include="Assets\Lock64.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KilitBul.Tests" />
  </ItemGroup>

</Project>
