<Window x:Class="KilitBul.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="980" Height="520" MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/KilitBul.ico"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding KillSelectedCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=ProcessGrid}" />
    </Window.InputBindings>

    <DockPanel Margin="12">
        <!-- Hedef -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hedef:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding TargetPath, Mode=OneWay}" IsReadOnly="True"
                     VerticalContentAlignment="Center" Padding="4" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Dosya seç…" Command="{Binding BrowseFileCommand}" />
            <Button Grid.Column="3" Content="Klasör seç…" Command="{Binding BrowseFolderCommand}" Margin="0" />
        </Grid>

        <!-- Durum çubuğu -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
            <ProgressBar DockPanel.Dock="Left" Width="120" Height="14" IsIndeterminate="True" Margin="0,0,8,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Eylemler -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Yenile (F5)" Command="{Binding RefreshCommand}" />
            <Button Content="İptal" Command="{Binding CancelScanCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Button Content="Kapat" ToolTip="Uygulamaya kapanma isteği gönderir (kaydetmeniz istenebilir). Seçim yoksa tümüne uygulanır."
                    Command="{Binding CloseSelectedCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=ProcessGrid}" />
            <Button Content="Zorla sonlandır (Del)" Foreground="DarkRed"
                    ToolTip="İşlemi hemen sonlandırır; kaydedilmemiş veriler kaybolur. Seçim yoksa tümüne uygulanır."
                    Command="{Binding KillSelectedCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=ProcessGrid}" />
            <Button Content="🛡 Yönetici olarak aç" Command="{Binding RestartElevatedCommand}"
                    Visibility="{Binding ShowElevateButton, Converter={StaticResource BoolToVis}}" />
            <Button Content="🗑 Şimdi sil" FontWeight="SemiBold" Command="{Binding DeleteTargetCommand}"
                    Visibility="{Binding IsTargetFree, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Liste -->
        <DataGrid x:Name="ProcessGrid" ItemsSource="{Binding Processes}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5E5E5" RowHeight="26">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding LockedPathsTooltip}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProtected}" Value="True">
                            <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Uygulama" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                <DataGridTextColumn Header="Tür" Binding="{Binding TypeDescription}" Width="120" />
                <DataGridTextColumn Header="Kilitli dosya" Binding="{Binding LockedPaths}" Width="2*" />
                <DataGridTextColumn Header="Exe yolu" Binding="{Binding ExecutablePath}" Width="2*" />
                <DataGridTextColumn Header="Başlangıç" Binding="{Binding StartTime}" Width="120" />
                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
