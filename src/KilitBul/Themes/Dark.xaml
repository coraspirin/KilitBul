<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Koyu tema renkleri (Windows 11 varsayılan paleti) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#ABABAB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5AB9E6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4FA5CC" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D13A2A" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
</ResourceDictionary>
